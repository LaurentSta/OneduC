############################################
# Laravel / PHP
############################################
/vendor/
/.env
.env.*
auth.json
Homestead.yaml
Homestead.json
/.vagrant
.phpunit.result.cache
/.phpunit.cache
.phpactor.json

############################################
# Node / Vite / Front
############################################
/node_modules/
npm-debug.log
yarn-error.log
/.vite
/.vite-inspect

# Builds générés
/public/build/
public/hot

############################################
# Cache / Logs / Storage
############################################
/bootstrap/cache/
/storage/framework/
/storage/logs/
/storage/debugbar/
storage/*.key
/storage/pail

############################################
# SCORM (lourd / local)
############################################
/public/modules/scorm/*
/resources/scorm/

############################################
# PUBLIC : stratégie "deny all" puis allowlist
############################################
# On ignore TOUT le contenu de public par défaut
/public/*

# On autorise les essentiels Laravel
!/public/index.php
!/public/.htaccess
!/public/robots.txt
!/public/favicon.ico

# On autorise les dossiers statiques utiles (non générés)
!/public/fonts/
!/public/fonts/**
!/public/images/
!/public/images/**
!/public/docs/
!/public/docs/**
!/public/confortplus/
!/public/confortplus/**
!/public/scorm_core/
!/public/scorm_core/**

# Assets backend/frontend :
# (Garde-les UNIQUEMENT si ce sont des fichiers statiques livrés, pas des artefacts de build)
!/public/backend/
!/public/backend/**
!/public/frontend/
!/public/frontend/**

############################################
# PUBLIC : exclusions explicites (sensibles / générés)
############################################
public/storage/
public/upload/
public/build/
public/phpmyadmin
public/test.php