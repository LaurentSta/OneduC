# SCORM (lourd)
############################################
/public/modules/scorm/*
/resources/scorm/

############################################
# PUBLIC : dépôt léger (deny all + allowlist)
############################################
# On ignore tout ce qui est dans public par défaut
/public/*

# Essentiels Laravel
!/public/index.php
!/public/.htaccess
!/public/robots.txt
!/public/favicon.ico

# Statique utile (si tu veux les versionner)
!/public/fonts/
!/public/fonts/**
!/public/images/
!/public/images/**
!/public/docs/
!/public/docs/**
!/public/confortplus/
!/public/confortplus/**
!/public/scorm_core/
!/public/scorm_core/**

############################################
# PUBLIC : exclusions explicites (toujours)
############################################
/public/build/
/public/hot
/public/storage/
/public/upload/
/public/phpmyadmin
/public/test.php