############################################
# ==============================
# LARAVEL / PHP
# ==============================
############################################

/vendor/
.env
.env.*
auth.json
Homestead.yaml
Homestead.json
/.vagrant
.phpunit.result.cache
/.phpunit.cache
.phpactor.json

############################################
# ==============================
# NODE / VITE
# ==============================
############################################

/node_modules/
npm-debug.log
yarn-error.log
/.vite
/.vite-inspect

############################################
# ==============================
# CACHE / STORAGE / LOGS
# ==============================
############################################

/bootstrap/cache/
/storage/*
!/storage/app
!/storage/app/public
!/storage/framework
!/storage/framework/cache
!/storage/framework/sessions
!/storage/framework/views
!/storage/logs/.gitignore
storage/*.key

############################################
# ==============================
# SCORM (lourd)
# ==============================
############################################

/public/modules/scorm/*
/resources/scorm/

############################################
# ==============================
# PUBLIC : dépôt léger
# ==============================
############################################

# On ignore TOUT le dossier public
/public/*

# === Fichiers indispensables Laravel ===
!/public/index.php
!/public/.htaccess
!/public/robots.txt
!/public/favicon.ico

# === Ressources statiques utiles (non générées) ===
!/public/fonts/
!/public/fonts/**
!/public/images/
!/public/images/**
!/public/docs/
!/public/docs/**
!/public/confortplus/
!/public/confortplus/**
!/public/scorm_core/
!/public/scorm_core/**

# === Si ces dossiers contiennent uniquement du statique livré ===
!/public/backend/
!/public/backend/**
!/public/frontend/
!/public/frontend/**

############################################
# ==============================
# EXCLUSIONS DEFINITIVES (sécurité)
# ==============================
############################################

/public/build/
/public/hot
/public/storage/
/public/upload/
/public/phpmyadmin
/public/test.php